{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SquadView",
  "version": "0.2.0",
  "identifier": "io.github.kaique292.squadview",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SquadView",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 560,
        "transparent": true,
        "decorations": false,
        "label": "main",
        "visible": false,
        "center": true
      },
      {
        "label": "splash",
        "title": "SquadView",
        "url": "splash.html",
        "width": 300,
        "height": 340,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true,
        "backgroundColor": "#1e1f22",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.discordapp.com; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Kaique Amaral",
    "copyright": "© 2026 Kaique Amaral. Licença MIT.",
    "category": "SocialNetworking",
    "shortDescription": "Compartilhe a tela com a galera da call, sem servidor.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCQkJGNUNDRUFEQjM5MDMKUldRRE9kdnF6UFc3eS8rc1BZY0RCVnhNYnJqbkRGOENHZi9QR2RMWE5XREN0UXpmMHJvTGcwalYK",
      "endpoints": [
        "https://github.com/Kaique292/squadview/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "squadview"
        ]
      }
    }
  }
}